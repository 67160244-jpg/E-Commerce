# ==============================================================================
# Mochi Vita - Web Server Security & Routing Configuration
# ==============================================================================

# ปิด Directory Listing ป้องกันการส่องดูโครงสร้างไฟล์
Options -Indexes -MultiViews

# เปิดใช้งาน RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. บังคับใช้ HTTPS เมื่อเปิดบนโดเมนจริง (ข้ามกรณี Localhost / 127.0.0.1)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. ปิดกั้นการเข้าถึงโฟลเดอร์สำคัญและไฟล์ระบบโดยตรง
    RewriteRule ^(config|includes|database|data|setup|tools|\.github|\.git)(/.*)?$ - [F,L,NC]

    # 3. นำทางหน้าแรก Root เข้าสู่ public/index.php
    RewriteRule ^$ public/index.php [L]
</IfModule>

# ปิดกั้นไฟล์นามสกุลอันตรายและข้อมูลลับ
<FilesMatch "\.(sql|csv|md|ps1|log|ini|env|sample\.php|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ปิดกั้นการเข้าถึงไฟล์ซ่อน (Hidden files .*)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers เพื่อความปลอดภัยของผู้ใช้งาน
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Caching สำหรับ Assets รูปภาพ สไตล์ และสคริปต์ เพื่อประหยัด CPU ของโฮสต์
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# หน้า 404 Not Found ภาษาไทย
ErrorDocument 404 /public/404.php
